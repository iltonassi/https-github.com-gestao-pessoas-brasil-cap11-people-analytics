# ==============================================================================
# ETAPA 4 - INTEGRAR TUDO EM UMA BASE ANALÍTICA (COM LGPD)
# ==============================================================================
titulo("ETAPA 4: integrando as bases")

df_analitico <- df_master %>%
  distinct(employee_id, .keep_all = TRUE) %>%
  # Ativos + saídas VOLUNTÁRIAS. Demissões pela empresa são outro fenômeno.
  filter(employment_status == "Active" |
         (employment_status == "Terminated" & termination_type == "Voluntary")) %>%
  # LGPD / Privacy by Design: nomes não servem à análise, então saem já aqui
  select(-any_of(c("first_name", "last_name"))) %>%
  mutate(
    turnover_voluntario = if_else(employment_status == "Terminated", 1, 0),
    status              = factor(turnover_voluntario, levels = c(0, 1), labels = c("Retido", "Turnover")),
    data_fim_observacao = coalesce(termination_date, data_referencia),
    # Correção da Armadilha 3: tempo de casa até a saída (ou até a referência)
    tempo_casa_meses    = round(as.numeric(data_fim_observacao - hire_date) / 30.44, 1),
    salario_mil         = base_salary / 1000   # em milhares: facilita a leitura do odds ratio
  )

# Dimensão CARREIRA: só vale o que aconteceu ATÉ a saída/referência (Armadilha 4a)
features_carreira <- df_promotions %>%
  inner_join(select(df_analitico, employee_id, data_fim_observacao), by = "employee_id") %>%
  filter(effective_date <= data_fim_observacao) %>%
  group_by(employee_id) %>%
  summarise(
    qtd_promocoes_internas   = sum(promotion_type == "Internal Promotion"),
    data_ultima_movimentacao = max(effective_date),
    .groups = "drop"
  )

df_analitico <- df_analitico %>%
  left_join(features_jornada,      by = "employee_id") %>%
  left_join(features_carreira,     by = "employee_id") %>%
  left_join(features_deslocamento, by = "employee_id") %>%
  left_join(features_sobrecarga,   by = "employee_id") %>%
  left_join(features_clima,        by = "employee_id") %>%
  mutate(
    data_ultima_movimentacao    = coalesce(data_ultima_movimentacao, hire_date),
    qtd_promocoes_internas      = coalesce(qtd_promocoes_internas, 0L),
    meses_desde_ultima_promocao = round(as.numeric(data_fim_observacao - data_ultima_movimentacao) / 30.44, 1),
    # Zero ESTRUTURAL: a Administração não atende pacientes
    avg_patient_nurse_ratio = coalesce(avg_patient_nurse_ratio, 0),
    max_patient_nurse_ratio = coalesce(max_patient_nurse_ratio, 0),
    # Lacuna de escala: preenchemos com a mediana (não com zero, que seria falso)
    across(c(total_turnos, media_horas_turno, media_horas_extras,
             pct_turnos_noturnos, pct_dias_hora_extra),
           ~ coalesce(.x, median(.x, na.rm = TRUE)))
  )

