titulo("ETAPA 9: regressão logística múltipla")

modelo_completo <- glm(status ~ ., data = treino, family = binomial)
modelo_final    <- step(modelo_completo, direction = "both", trace = FALSE)

cat("\nVariáveis que o stepwise manteve:\n  ",
    paste(attr(terms(modelo_final), "term.labels"), collapse = "\n   "), "\n")
print(summary(modelo_final))

pseudo_r2 <- function(m) 1 - m$deviance / m$null.deviance  # R² de McFadden
auc_teste <- function(m) {
  as.numeric(auc(roc(teste$status, predict(m, teste, type = "response"),
                     levels = c("Retido", "Turnover"), direction = "<", quiet = TRUE)))
}
comparacao_modelos <- tibble(
  modelo        = c("1. Simples (horas extras)", "2. Completo", "3. Final (stepwise)"),
