# Confere se cada arquivo existe. Se não existir com a extensão indicada,
# tenta a outra extensão. Se não existir de jeito nenhum, para com mensagem clara.
for (base in names(arquivos)) {
  nome <- arquivos[[base]]
  if (!file.exists(file.path(pasta_dados, nome))) {
    alternativo <- ifelse(str_detect(nome, "\\.csv$"),
                          str_replace(nome, "\\.csv$", ".xlsx"),
                          str_replace(nome, "\\.xlsx?$", ".csv"))
    if (file.exists(file.path(pasta_dados, alternativo))) {
      cat("Aviso:", nome, "não existe; usando", alternativo, "\n")
      arquivos[[base]] <- alternativo
    } else {
      stop("\nNão encontrei '", nome, "' nem '", alternativo, "' na pasta escolhida.\n",
           "Compare com a lista de arquivos impressa acima e corrija o nome no PASSO 2.",
           call. = FALSE)
    }
  }
}

# ------------------------------------------------------------------------------
# PASSO 3 - LEITURA: cada extensão tem a sua função
# ------------------------------------------------------------------------------
#   .xlsx                    -> read_excel()
#   .csv com ponto e vírgula -> read_delim(";")  (padrão brasileiro)
#   .csv com vírgula         -> read_csv()       (padrão internacional, ponto decimal)
ler_arquivo <- function(nome_arquivo) {
  caminho <- file.path(pasta_dados, nome_arquivo)
  if (str_detect(tolower(nome_arquivo), "\\.xlsx?$")) {
    dados <- read_excel(caminho)
  } else if (str_detect(readLines(caminho, n = 1, warn = FALSE), ";")) {
    # lê tudo como texto e converte depois: funciona com "8,0" e com "8.0"
    dados <- read_delim(caminho, delim = ";", show_col_types = FALSE,
                        col_types = cols(.default = col_character())) %>%
      mutate(across(everything(), ~ if (all(str_detect(na.omit(.x), "^-?[0-9]+([.,][0-9]+)?$")))
                                      para_numero(.x) else .x))
  } else {
    dados <- read_csv(caminho, show_col_types = FALSE)
  }
  padronizar_nomes(dados)
}

