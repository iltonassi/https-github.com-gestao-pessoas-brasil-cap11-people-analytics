# ==============================================================================
# ETAPA 12 - O RESULTADO SE SUSTENTA? VALIDAÇÃO CRUZADA
# ==============================================================================
# Um único sorteio treino/teste pode dar sorte (ou azar). A validação cruzada
# repete o processo 25 vezes (5 partes x 5 repetições) e mostra a variação.
titulo("ETAPA 12: validação cruzada (5 partes x 5 repetições)")

controle_cv <- trainControl(method = "repeatedcv", number = 5, repeats = 5,
                            classProbs = TRUE, summaryFunction = twoClassSummary)
modelo_cv <- train(formula(modelo_final), data = treino, method = "glm",
                   family = binomial, metric = "ROC", trControl = controle_cv)

resultado_cv <- modelo_cv$resample %>%
  summarise(AUC_media = mean(ROC), AUC_min = min(ROC), AUC_max = max(ROC), AUC_desvio = sd(ROC)) %>%
  mutate(across(everything(), ~ round(.x, 3)))
mostrar(resultado_cv)
leitura(sprintf("nas 25 rodadas, a AUC variou de %s a %s (média %s).",
                br(resultado_cv$AUC_min, 2), br(resultado_cv$AUC_max, 2), br(resultado_cv$AUC_media, 2)),
        if_else(abs(resultado_cv$AUC_media - auc_valor) < 0.05,
                "O resultado do teste é consistente: não foi sorte.",
                "O resultado do teste difere da média: interprete com cautela."))


# ==============================================================================
# ETAPA 13 - DO MODELO À DECISÃO: MATRIZ RISCO x DESEMPENHO
# ==============================================================================
# Agora aplicamos o modelo aos ATIVOS e cruzamos risco de saída com desempenho.
# A pesquisa de clima volta aqui: não para prever, mas para explicar e agir.
titulo("ETAPA 13: plano de ação para os colaboradores ativos")

ativos <- df_analitico %>%
  filter(turnover_voluntario == 0) %>%
  mutate(gender     = factor(gender, levels = levels(treino$gender)),
         department = factor(department, levels = levels(treino$department)))

ativos$prob_turnover <- predict(modelo_final, newdata = ativos, type = "response")

ativos <- ativos %>%
  filter(!is.na(prob_turnover)) %>%
  mutate(
    custo_estimado_reposicao = round(base_salary * 1.5, 2),  # premissa: 1,5x o salário anual
    nivel_risco = case_when(
      prob_turnover >= corte_otimo        ~ "1. Alto risco",
      prob_turnover >= corte_otimo * 0.65 ~ "2. Médio risco",
      TRUE                                ~ "3. Baixo risco"
    ),
    alto_desempenho = performance_rating >= 4.0,
    quadrante_acao = case_when(
      nivel_risco == "1. Alto risco"  &  alto_desempenho ~ "1. CRÍTICO: reter talento já",
      nivel_risco == "1. Alto risco"  & !alto_desempenho ~ "2. ALERTA: mitigar risco operacional",
      nivel_risco == "2. Médio risco" &  alto_desempenho ~ "3. MONITORAR: carreira e clima",
      TRUE                                               ~ "4. MANUTENÇÃO: gestão de rotina"
    )
  )

resumo_executivo <- ativos %>%
  group_by(quadrante_acao) %>%
  summarise(
    colaboradores          = n(),
    risco_medio_pct        = round(mean(prob_turnover) * 100, 1),
    tempo_casa_meses       = round(mean(tempo_casa_meses), 1),
    horas_extras_media     = round(mean(media_horas_extras), 2),
    meses_sem_promocao     = round(mean(meses_desde_ultima_promocao), 1),
    satisfacao_geral       = round(mean(overall_satisfaction, na.rm = TRUE), 2),
    eficacia_gestor        = round(mean(manager_effectiveness, na.rm = TRUE), 2),
    exposicao_financeira   = sum(custo_estimado_reposicao),
    .groups = "drop"
  )
mostrar(resumo_executivo)
write_excel_csv2(resumo_executivo, file.path(pasta_saida, "06_resumo_executivo.csv"))

criticos <- filter(resumo_executivo, str_detect(quadrante_acao, "CRÍTICO"))
if (nrow(criticos) > 0) {
  leitura(sprintf("%d talentos de alto desempenho estão em alto risco. Exposição financeira estimada: %s.",
                  criticos$colaboradores, br(criticos$exposicao_financeira, 0)),
          sprintf("Eles têm, em média, %s meses de casa, contra %s no grupo de manutenção:",
                  br(criticos$tempo_casa_meses),
                  br(resumo_executivo$tempo_casa_meses[str_detect(resumo_executivo$quadrante_acao, "MANUTENÇÃO")])),
          "o risco se concentra nos primeiros anos. Onboarding e integração viram prioridade.")
}

# Clima por quadrante: o que cada grupo sente de diferente?
# (quem não respondeu à pesquisa aparece como NA e é ignorado nas médias)
clima_quadrante <- ativos %>%
  group_by(quadrante_acao) %>%
  summarise(respondentes = sum(!is.na(overall_satisfaction)),
            across(any_of(itens_clima), ~ round(mean(.x, na.rm = TRUE), 2)), .groups = "drop")
cat("\nPesquisa de clima por quadrante (escala 1 a 5):\n")
mostrar(clima_quadrante)
pior_item <- clima_quadrante %>%
  pivot_longer(any_of(itens_clima), names_to = "item", values_to = "media") %>%
  slice_min(media, n = 1, with_ties = FALSE)
leitura(sprintf("o ponto mais baixo do clima é '%s' no grupo '%s' (média %s de 5):",
                pior_item$item, pior_item$quadrante_acao, br(pior_item$media, 2)),
        "um bom ponto de partida para as stay interviews.")

top_prioridades <- ativos %>%
  filter(str_detect(quadrante_acao, "CRÍTICO")) %>%
  arrange(desc(prob_turnover)) %>%
  transmute(employee_id, department, job_level, performance_rating,
            risco_pct = round(prob_turnover * 100, 1),
            media_horas_extras = round(media_horas_extras, 2),
            meses_desde_ultima_promocao, overall_satisfaction, manager_effectiveness,
            custo_estimado_reposicao) %>%
  head(10)
cat("\nTop 10 talentos críticos para stay interviews (somente matrícula - LGPD):\n")
mostrar(top_prioridades)
write_excel_csv2(top_prioridades, file.path(pasta_saida, "07_top10_stay_interviews.csv"))

cores_quadrante <- c("1. CRÍTICO: reter talento já"         = "#C0392B",
                     "2. ALERTA: mitigar risco operacional" = "#E67E22",
                     "3. MONITORAR: carreira e clima"       = "#F1C40F",
                     "4. MANUTENÇÃO: gestão de rotina"      = "#27AE60")

g9 <- ggplot(ativos, aes(x = prob_turnover, y = performance_rating, color = quadrante_acao)) +
  geom_point(aes(size = base_salary), alpha = 0.7) +
  geom_vline(xintercept = corte_otimo, linetype = "dashed", color = "gray30") +
  geom_hline(yintercept = 4.0, linetype = "dashed", color = "gray30") +
  scale_color_manual(values = cores_quadrante) +
  scale_size_continuous(range = c(1, 6), labels = function(x) br(x, 0)) +
  guides(color = guide_legend(nrow = 2), size = guide_legend(nrow = 1)) +
  labs(title = "Matriz executiva: risco de saída x desempenho",
       subtitle = "Linha vertical = corte de Youden | Linha horizontal = desempenho 4,0 | Bolha = salário",
       x = "Probabilidade prevista de turnover voluntário", y = "Avaliação de desempenho",
       color = NULL, size = "Salário base") +
  tema_cap11 + theme(legend.box = "vertical")
salvar_grafico(g9, "g09_matriz_risco_desempenho.png", 10, 7)

g10 <- clima_quadrante %>%
  pivot_longer(any_of(itens_clima), names_to = "item", values_to = "media") %>%
  ggplot(aes(x = reorder(item, media), y = media, fill = quadrante_acao)) +
  geom_col(position = position_dodge(width = 0.8), width = 0.75) +
  coord_flip(ylim = c(1, 5)) +
  scale_fill_manual(values = cores_quadrante) +
  guides(fill = guide_legend(nrow = 2)) +
  labs(title = "O que o clima revela em cada quadrante?",
       subtitle = "Média dos itens da pesquisa de engajamento (1 a 5) - colaboradores ativos",
       x = NULL, y = "Média", fill = NULL) +
  tema_cap11
salvar_grafico(g10, "g10_clima_por_quadrante.png", 10, 7)


