  media_horas_extras             = "cada hora extra a mais por turno",
  qtd_promocoes_internas         = "cada promoção interna a mais",
  meses_desde_ultima_promocao    = "cada mês a mais sem promoção",
  estimated_commute_time_minutes = "cada minuto a mais de deslocamento",
  max_patient_nurse_ratio        = "cada paciente a mais no pico por profissional"
)
for (i in seq_len(nrow(tabela_or))) {
  termo <- tabela_or$term[i]
  quem  <- if (termo %in% names(unidades)) unidades[[termo]] else paste0("pertencer a '", termo, "' (vs. referência)")
  leitura(sprintf("%s %s a chance de saída em %s%% (%s; %s%s).",
                  str_to_sentence(quem),
                  if_else(tabela_or$odds_ratio[i] > 1, "AUMENTA", "REDUZ"),
                  br(abs(tabela_or$variacao_chance_pct[i])), tabela_or$papel[i], p_frase(tabela_or$p_num[i]),
                  if_else(tabela_or$p_num[i] < 0.05, "", ", efeito incerto")))
}
leitura("atenção: o odds ratio compara pessoas IGUAIS nas demais variáveis do modelo.",
        "Por isso pode contrariar a comparação simples da Etapa 6: uma variável sem diferença",
        "isolada pode ganhar força quando 'controlamos' o tempo de casa, por exemplo.")

g7 <- ggplot(tabela_or, aes(x = reorder(term, odds_ratio), y = odds_ratio, color = papel)) +
  geom_hline(yintercept = 1, linetype = "dashed", color = "gray40") +
