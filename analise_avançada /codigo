# ==============================================================================
# ETAPA 10 - TRADUZINDO PARA O RH: ODDS RATIOS
# ==============================================================================
# Odds ratio (OR) = quanto a CHANCE de sair é multiplicada a cada +1 unidade.
#   OR > 1  -> fator de RISCO      |  OR < 1 -> fator de PROTEÇÃO
titulo("ETAPA 10: fatores de risco e de proteção (odds ratios)")

tabela_or <- tidy(modelo_final, conf.int = TRUE, exponentiate = TRUE) %>%
  filter(term != "(Intercept)") %>%
  mutate(
    variacao_chance_pct = round((estimate - 1) * 100, 1),
    papel = if_else(estimate > 1, "RISCO", "PROTEÇÃO"),
    significancia = case_when(
      p.value < 0.001 ~ "***",
      p.value < 0.01  ~ "**",
      p.value < 0.05  ~ "*",
      p.value < 0.10  ~ ".",
      TRUE            ~ "ns"
    ),
    across(c(estimate, conf.low, conf.high), ~ round(.x, 3))
  ) %>%
  arrange(p.value) %>%
  mutate(p_valor = formatar_p(p.value)) %>%
  select(term, odds_ratio = estimate, variacao_chance_pct, ic_inferior = conf.low,
         ic_superior = conf.high, p_valor, significancia, papel, p_num = p.value)
mostrar(select(tabela_or, -p_num))
write_excel_csv2(select(tabela_or, -p_num), file.path(pasta_saida, "04_odds_ratios.csv"))

# Dicionário: o que significa "+1 unidade" em cada variável
unidades <- c(
  tempo_casa_meses               = "cada mês a mais de casa",
  salario_mil                    = "cada 1 mil a mais de salário anual",
  age                            = "cada ano a mais de idade",
