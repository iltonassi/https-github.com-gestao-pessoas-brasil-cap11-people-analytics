# Imprime um título bem visível no Console
titulo <- function(texto) {
  cat("\n", strrep("=", 78), "\n ", texto, "\n", strrep("=", 78), "\n", sep = "")
}

# Imprime uma "leitura" em linguagem simples, para quem não é estatístico
leitura <- function(...) cat("\n>> LEITURA:", ..., "\n")

# Mostra tabelas inteiras, sem cortar colunas
mostrar <- function(tabela) print(as.data.frame(tabela), row.names = FALSE)

# Formata números no padrão brasileiro: 1.234,5
br <- function(x, casas = 1) formatC(x, format = "f", digits = casas, big.mark = ".", decimal.mark = ",")

# Formata p-valores: "< 0,0001" ou "0,0318"
formatar_p <- function(p) if_else(p < 0.0001, "< 0,0001", br(p, 4))
p_frase    <- function(p) if_else(p < 0.0001, "p < 0,0001", paste("p =", br(p, 4)))

# Padroniza nomes de colunas: "Employee_ID" -> "employee_id"
padronizar_nomes <- function(dados) {
  rename_with(dados, ~ .x %>%
    str_trim() %>%
    str_to_lower() %>%
    str_replace_all("[^a-z0-9]+", "_") %>%
    str_remove_all("^_|_$"))
}

# Converte texto em número aceitando "75383.59" e "75383,59"
para_numero <- function(x) {
  if (is.numeric(x)) return(x)
  as.numeric(str_replace(str_trim(as.character(x)), ",", "."))
}

# Converte datas vindas do Excel, de "2024-05-05" ou de "05/05/2024"
para_data <- function(x) {
  if (inherits(x, "Date"))   return(x)
  if (inherits(x, "POSIXt")) return(as.Date(x))
  x   <- as.character(x)
  out <- as.Date(x, format = "%Y-%m-%d")
  sem_data <- is.na(out) & !is.na(x)
  out[sem_data] <- as.Date(x[sem_data], format = "%d/%m/%Y")
  out
}

# Compara Retidos x Saídas Voluntárias em várias variáveis numéricas.
# Usa o teste de Mann-Whitney: não exige distribuição normal.
comparar_grupos <- function(dados, rotulos) {
  map_dfr(names(rotulos), function(v) {
    ret <- dados[[v]][dados$status == "Retido"]
    sai <- dados[[v]][dados$status == "Turnover"]
    p   <- wilcox.test(sai, ret, exact = FALSE)$p.value
    tibble(
      indicador        = rotulos[[v]],
      media_retidos    = round(mean(ret, na.rm = TRUE), 2),
      media_turnover   = round(mean(sai, na.rm = TRUE), 2),
      diferenca_pct    = round((mean(sai, na.rm = TRUE) / mean(ret, na.rm = TRUE) - 1) * 100, 1),
      p_valor          = formatar_p(p),
      veredito         = if_else(p < 0.05, "DIFERENÇA REAL", "pode ser acaso")
    )
  })
}

# Gera a leitura automática da dimensão: destaca a maior diferença confiável
ler_dimensao <- function(tabela, nome_dimensao) {
  reais <- filter(tabela, veredito == "DIFERENÇA REAL")
  if (nrow(reais) == 0) {
    leitura(sprintf("%s: nenhuma diferença confiável entre quem fica e quem sai.", nome_dimensao))
  } else {
    top <- slice_max(reais, abs(diferenca_pct), n = 1, with_ties = FALSE)
    leitura(sprintf("%s: o sinal mais forte é '%s'. Quem saiu tem média %s vs. %s de quem ficou (%s%%).",
                    nome_dimensao, top$indicador, br(top$media_turnover, 2), br(top$media_retidos, 2),
                    br(top$diferenca_pct)))
  }
}

