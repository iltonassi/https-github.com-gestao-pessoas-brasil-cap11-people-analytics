# ==============================================================================
# ETAPA 11 - O MODELO ACERTA? MATRIZ DE CONFUSÃO, ROC E PONTO DE CORTE
# ==============================================================================
# O modelo devolve uma PROBABILIDADE. Para virar decisão ("alerta" ou "não"),
# precisamos de um ponto de corte. O corte de 0,50 parece natural... mas será?
titulo("ETAPA 11: avaliação no conjunto de teste")

prob_teste <- predict(modelo_final, newdata = teste, type = "response")

classificar <- function(prob, corte) {
  factor(if_else(prob >= corte, "Turnover", "Retido"), levels = c("Retido", "Turnover"))
}

cm_50 <- confusionMatrix(classificar(prob_teste, 0.50), teste$status, positive = "Turnover")
cat("\n--- MATRIZ 1: corte padrão 0,50 ---\n")
print(cm_50$table)

roc_obj   <- roc(teste$status, prob_teste, levels = c("Retido", "Turnover"), direction = "<", quiet = TRUE)
auc_valor <- as.numeric(auc(roc_obj))
corte_otimo <- coords(roc_obj, "best", best.method = "youden", ret = "threshold",
                      transpose = FALSE)$threshold[1]

cm_youden <- confusionMatrix(classificar(prob_teste, corte_otimo), teste$status, positive = "Turnover")
cat(sprintf("\n--- MATRIZ 2: corte otimizado por Youden (%s) ---\n", br(corte_otimo, 3)))
print(cm_youden$table)

metricas <- function(cm, nome) {
  tibble(corte = nome,
         acuracia = cm$overall[["Accuracy"]],
         sensibilidade_saidas_detectadas = cm$byClass[["Sensitivity"]],
         especificidade_retidos_corretos = cm$byClass[["Specificity"]],
         precisao_alertas_corretos = cm$byClass[["Pos Pred Value"]],
         saidas_reais = sum(cm$table[, "Turnover"]),
         saidas_detectadas = cm$table["Turnover", "Turnover"])
}
comparacao_cortes <- bind_rows(metricas(cm_50, "0,50 (padrão)"),
                               metricas(cm_youden, paste(br(corte_otimo, 3), "(Youden)"))) %>%
  mutate(across(where(is.double), ~ round(.x, 3)))
cat("\nComparação lado a lado:\n")
mostrar(comparacao_cortes)
write_excel_csv2(comparacao_cortes, file.path(pasta_saida, "05_comparacao_cortes.csv"))

cat(sprintf("\nAUC (área sob a curva ROC): %s\n", br(auc_valor, 3)))
leitura(sprintf("com corte 0,50 o modelo encontra %d de %d saídas reais. Com Youden, encontra %d,",
                comparacao_cortes$saidas_detectadas[1], comparacao_cortes$saidas_reais[1],
                comparacao_cortes$saidas_detectadas[2]),
        sprintf("embora a acurácia caia de %s%% para %s%%.",
                br(comparacao_cortes$acuracia[1] * 100), br(comparacao_cortes$acuracia[2] * 100)),
        "Com classes desbalanceadas, a acurácia engana: perder um talento custa mais que um alarme falso.")
leitura(sprintf("AUC = %s: escolhendo ao acaso uma pessoa que saiu e uma que ficou, o modelo dá risco",
                br(auc_valor, 2)), sprintf("maior a quem saiu em %s%% das vezes (0,5 = moeda; 1,0 = perfeito).",
                br(auc_valor * 100, 0)))

ponto_youden <- coords(roc_obj, corte_otimo, input = "threshold",
                       ret = c("specificity", "sensitivity"), transpose = FALSE)
g8 <- ggroc(roc_obj, color = "#2980B9", linewidth = 1.3, legacy.axes = TRUE) +
  geom_abline(slope = 1, intercept = 0, linetype = "dashed", color = "gray50") +
  annotate("point", x = 1 - ponto_youden$specificity[1], y = ponto_youden$sensitivity[1],
           size = 4, color = "#C0392B") +
  annotate("text", x = 1 - ponto_youden$specificity[1], y = ponto_youden$sensitivity[1],
           label = paste("  Youden =", br(corte_otimo, 3)), hjust = 0, vjust = 1.5, color = "#C0392B") +
  labs(title = paste0("Curva ROC - previsão de turnover voluntário (AUC = ", br(auc_valor, 3), ")"),
       subtitle = "Linha tracejada = acerto ao acaso", x = "1 - Especificidade (alarmes falsos)",
       y = "Sensibilidade (saídas detectadas)") +
  tema_cap11
