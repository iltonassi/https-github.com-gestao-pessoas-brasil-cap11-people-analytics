  AIC           = round(c(AIC(modelo_simples), AIC(modelo_completo), AIC(modelo_final)), 1),
  pseudo_R2     = round(c(pseudo_r2(modelo_simples), pseudo_r2(modelo_completo), pseudo_r2(modelo_final)), 3),
  AUC_teste     = round(c(auc_teste(modelo_simples), auc_teste(modelo_completo), auc_teste(modelo_final)), 3)
)
